<?xml version="1.0" encoding="utf-8"?>
<!-- Imported configuration and test settings may hold internal hosts and credentials:
     never back them up or transfer them. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="private-config/" />
        <exclude domain="sharedpref" path="throughput_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="private-config/" />
        <exclude domain="sharedpref" path="throughput_settings.xml" />
    </device-transfer>
</data-extraction-rules>
