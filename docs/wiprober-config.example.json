{
  "format": "wiprober-config",
  "version": 1,
  "credentials": {
    "password": "change-me"
  },
  "throughput": {
    "iperf": {
      "enabled": true,
      "label": "corporate",
      "host": "iperf.example.com",
      "port": 5201,
      "durationSeconds": 5
    },
    "internet": {
      "enabled": true,
      "downloadUrl": "https://speed.cloudflare.com/__down?bytes={bytes}",
      "uploadUrl": "https://speed.cloudflare.com/__up",
      "durationSeconds": 5
    }
  },
  "guide": {
    "enabled": true,
    "spacingMeters": 10,
    "coverageRadiusMeters": 5,
    "ssid": "CORP-WIFI",
    "profile": "pda"
  },
  "roaming": {
    "enabled": true,
    "host": "${gateway}",
    "port": 443,
    "intervalMs": 200
  },
  "requirements": {
    "_comment": "Optional thresholds of the report verdict (example values, not defaults). Omit the section for no verdict.",
    "throughput": [
      {
        "alias": "corporate",
        "minDownMbps": 20,
        "minUpMbps": 10,
        "maxLatencyMedianMs": 30,
        "maxLatencyP95Ms": 80,
        "maxLatencyLossPct": 5
      }
    ],
    "networkTests": [
      {
        "alias": "gateway",
        "maxMedianMs": 20,
        "maxLossPct": 2
      },
      {
        "alias": "app-web",
        "maxMedianMs": 300,
        "maxP95Ms": 800
      }
    ],
    "roaming": {
      "maxOutageMs": 500,
      "maxLossesPerFloor": 3
    }
  },
  "apNames": [
    {
      "bssid": "02:00:00:00:30:04",
      "name": "AP-P3-04",
      "location": "Pasillo 3",
      "floor": "Baja"
    },
    {
      "bssid": "02:00:00:00:31:04",
      "name": "AP-P3-04",
      "location": "Pasillo 3",
      "floor": "Baja"
    },
    {
      "bssid": "02:00:00:00:30:05",
      "name": "AP-P3-05",
      "location": "Muelle 5",
      "floor": "Baja"
    }
  ],
  "tests": [
    {
      "name": "gateway",
      "type": "ping",
      "host": "${gateway}",
      "count": 10
    },
    {
      "name": "dns-app",
      "type": "dns",
      "host": "app.example.com"
    },
    {
      "name": "app-db",
      "type": "tcp",
      "host": "10.0.0.5",
      "port": 1521
    },
    {
      "name": "app-web",
      "type": "http",
      "url": "https://app.example.com/health",
      "expectStatus": 200
    }
  ],
  "scripts": [
    {
      "name": "item-lookup",
      "variables": {
        "user": "survey"
      },
      "steps": [
        {
          "name": "login",
          "method": "POST",
          "allowWrite": true,
          "url": "https://app.example.com/api/login",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": "{\"user\":\"${user}\",\"password\":\"${secret.password}\"}",
          "expectStatus": 200,
          "extract": {
            "token": "$.data.token"
          }
        },
        {
          "name": "location",
          "url": "https://app.example.com/api/locations/A-01",
          "headers": {
            "Authorization": "Bearer ${token}"
          },
          "expectContains": "A-01"
        }
      ],
      "alias": "Item lookup"
    }
  ]
}
