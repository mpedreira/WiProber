{
  "log": {
    "version": "1.2",
    "creator": { "name": "Example browser", "version": "1" },
    "entries": [
      {
        "_resourceType": "document",
        "request": {
          "method": "GET",
          "url": "https://stock.example.com/app/?lang=en",
          "headers": [
            { "name": "Accept", "value": "text/html" },
            { "name": "Cookie", "value": "session=FAKE-session-not-imported" }
          ]
        }
      },
      {
        "_resourceType": "xhr",
        "request": {
          "method": "GET",
          "url": "https://stock.example.com/api/items?sku=12345&access_token=FAKE-token-replaced",
          "headers": [
            { "name": "Accept", "value": "application/json" },
            { "name": "Authorization", "value": "Bearer FAKE-bearer-replaced" }
          ]
        }
      },
      {
        "_resourceType": "image",
        "request": { "method": "GET", "url": "https://stock.example.com/logo.png", "headers": [] }
      }
    ]
  }
}
